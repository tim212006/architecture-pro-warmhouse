@startuml
!include <C4/C4_Context>

title Контекстная диаграмма C4 — монолит «Тёплый дом» (As-Is)

Person(owner, "Владелец дома", "Пользуется веб-интерфейсом: включает и выключает отопление, смотрит текущую температуру")
Person(engineer, "Сервисный инженер", "Выезжает на объект, регистрирует и подключает модуль отопления и датчик")

System(monolith, "Монолит «Тёплый дом»", "Go + PostgreSQL. Управление отоплением и мониторинг температуры в одном приложении")

System_Ext(heatingModule, "Модуль управления отоплением", "Устройство в доме, исполняет команды включения и выключения")
System_Ext(tempSensor, "Датчик температуры", "Устройство в доме, отдаёт текущее значение температуры")

Rel(owner, monolith, "Управляет отоплением, просматривает температуру", "HTTPS")
Rel(engineer, monolith, "Регистрирует дом и подключает устройства", "Веб-интерфейс")
Rel(monolith, heatingModule, "Отправляет команды и запрашивает состояние", "HTTP, инициатор — сервер")
Rel(monolith, tempSensor, "Запрашивает текущую температуру", "HTTP, инициатор — сервер")

@enduml
