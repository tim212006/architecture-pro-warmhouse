@startuml
title ER-обзор экосистемы «Тёплый дом»

left to right direction
hide circle
skinparam shadowing false
skinparam nodesep 35
skinparam ranksep 55

package "Access Service" {
  entity "users" as users #DDEBF7 {
    * id : uuid <<PK>>
    --
    * email : citext
    * full_name : varchar
    * status : varchar
  }

  entity "houses" as houses #DDEBF7 {
    * id : uuid <<PK>>
    --
    * address : varchar
    * timezone : varchar
  }

  entity "house_memberships" as house_memberships #DDEBF7 {
    * user_id : uuid <<PK, FK>>
    * house_id : uuid <<PK, FK>>
    --
    * role : varchar
    * status : varchar
  }
}

package "Device Service" {
  entity "modules" as modules #E2EFDA {
    * id : uuid <<PK>>
    --
    * code : varchar
    * name : varchar
    * category : varchar
    * price : numeric
  }

  entity "device_types" as device_types #E2EFDA {
    * id : uuid <<PK>>
    --
    * code : varchar
    * name : varchar
    * protocol : varchar
    * capabilities : jsonb
  }

  entity "house_modules" as house_modules #E2EFDA {
    * id : uuid <<PK>>
    --
    * house_id : uuid <<FK>>
    * module_id : uuid <<FK>>
    * status : varchar
  }

  entity "devices" as devices #E2EFDA {
    * id : uuid <<PK>>
    --
    * house_id : uuid <<FK>>
    * type_id : uuid <<FK>>
    * house_module_id : uuid <<FK>>
    * serial_number : varchar
    * desired_state : jsonb
    * reported_state : jsonb
  }
}

package "Telemetry Service" {
  entity "telemetry_data" as telemetry_data #FFF2CC {
    * id : bigserial <<PK>>
    --
    * device_id : uuid <<logical FK>>
    * metric : varchar
    * value : numeric
    * recorded_at : timestamptz
  }
}

package "Automation Service" {
  entity "scenarios" as scenarios #FCE4D6 {
    * id : uuid <<PK>>
    --
    * house_id : uuid <<logical FK>>
    * name : varchar
    * enabled : boolean
    * trigger_type : varchar
  }
}

users ||--o{ house_memberships
houses ||--o{ house_memberships
houses ||--o{ house_modules
modules ||--o{ house_modules
houses ||--o{ devices
device_types ||--o{ devices
house_modules |o--o{ devices
devices ||--o{ telemetry_data
houses ||--o{ scenarios

note bottom of telemetry_data
  Обзор не показывает служебные сущности:
  module_device_types, commands, scenario_actions, device_claims.
  Они раскрыты на детальных ER-диаграммах.
end note

@enduml
